#!/usr/bin/env bash
set -eu

if [[ $# -lt 1 ]]; then
	>&2 echo "Usage: $0 <file|directory>"
	exit 1
fi

TARGET="$1"
BASE_URL="https://distfiles.gentoo.org/pub/proj/tex/"

upload_file() {
	local file="$1"

	if [[ ! -f "${file}" ]] || [[ "${file}" == *.sig ]]; then
		return 0
	fi

	local filename="${file#./}"
	local local_size
	local_size=$(stat -c %s "${file}")

	# Fetch the remote file size via an HTTP HEAD request.
	# -f ensures curl fails silently on HTTP 404 (Not Found).
	local remote_size
	remote_size=$(curl -s -I -f "${BASE_URL}${filename}" 2>/dev/null | awk -v IGNORECASE=1 '/^content-length:/ {print $2}' | tr -d '\r' || true)

	if [[ "${local_size}" == "${remote_size}" ]]; then
		echo "Skipping ${filename}: already exists on target with matching size (${local_size} bytes)."
		return 0
	fi

	local file_sig="${file}.sig"
	if [[ ! -f "${file_sig}" ]]; then
		gpg --detach --sign --output "${file_sig}" "${file}"
	fi

	# XXX: It seems that "kup putraw" does not return a non-zero exit
	# status on failure :(
	# XXX: It would be great if putraw could check if the file already
	# exists and not do the put if it's the same file we are going to
	# put(raw)
	echo "Uploading ${filename}..."
	kup putraw "${file}" "${file_sig}" /pub/proj/tex/
}

if [[ -f "${TARGET}" ]]; then
	# cd to the file's parent directory so basename and relative paths remain consistent
	cd "$(dirname "${TARGET}")"
	upload_file "$(basename "${TARGET}")"
elif [[ -d "${TARGET}" ]]; then
	cd "${TARGET}"
	for FILE in ./*; do
		upload_file "${FILE}"
	done
else
	>&2 echo "ERROR: First argument must be a valid file or directory."
	exit 1
fi
